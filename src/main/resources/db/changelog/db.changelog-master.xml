<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="taskflow">
        <createTable tableName="roles">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(100)"/>
            <column name="last_name" type="VARCHAR(100)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="role_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="users"
                baseColumnNames="role_id"
                referencedTableName="roles"
                referencedColumnNames="id"
                constraintName="fk_users_role"/>

        <createTable tableName="projects">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="owner_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="project_members">
            <column name="project_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="tasks">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="TODO"/>
            <column name="priority" type="VARCHAR(20)" defaultValue="MEDIUM"/>
            <column name="story_points" type="INT"/>
            <column name="due_date" type="DATE"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="project_id" type="BIGINT"/>
            <column name="assignee_id" type="BIGINT"/>
            <column name="reporter_id" type="BIGINT"/>
            <column name="sprint_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="comments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="content" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="task_id" type="BIGINT"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="attachments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_path" type="VARCHAR(500)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="uploaded_at" type="TIMESTAMP"/>
            <column name="task_id" type="BIGINT"/>
            <column name="uploaded_by_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="task_history">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="field_name" type="VARCHAR(100)"/>
            <column name="old_value" type="VARCHAR(2000)"/>
            <column name="new_value" type="VARCHAR(2000)"/>
            <column name="changed_at" type="TIMESTAMP"/>
            <column name="task_id" type="BIGINT"/>
            <column name="changed_by_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="labels">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="color" type="VARCHAR(20)"/>
            <column name="description" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createTable tableName="task_labels">
            <column name="task_id" type="BIGINT"/>
            <column name="label_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="notifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="message" type="VARCHAR(500)"/>
            <column name="link" type="VARCHAR(255)"/>
            <column name="metadata" type="VARCHAR(500)"/>
            <column name="type" type="VARCHAR(50)"/>
            <column name="is_read" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="read_at" type="TIMESTAMP"/>
            <column name="user_id" type="BIGINT"/>
        </createTable>

        <createTable tableName="sprints">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="goal" type="VARCHAR(500)"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="velocity" type="INT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PLANNED"/>
            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="project_id" type="BIGINT"/>
        </createTable>

        <!-- Foreign Keys -->
        <addForeignKeyConstraint baseTableName="projects" baseColumnNames="owner_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_projects_owner"/>

        <addForeignKeyConstraint baseTableName="project_members" baseColumnNames="project_id"
                                 referencedTableName="projects" referencedColumnNames="id"
                                 constraintName="fk_project_members_project"/>

        <addForeignKeyConstraint baseTableName="project_members" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_project_members_user"/>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="project_id"
                                 referencedTableName="projects" referencedColumnNames="id"
                                 constraintName="fk_tasks_project"/>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="assignee_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_tasks_assignee"/>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="reporter_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_tasks_reporter"/>

        <addForeignKeyConstraint baseTableName="tasks" baseColumnNames="sprint_id"
                                 referencedTableName="sprints" referencedColumnNames="id"
                                 constraintName="fk_tasks_sprint"/>

        <addForeignKeyConstraint baseTableName="comments" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_comments_task"/>

        <addForeignKeyConstraint baseTableName="comments" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_comments_user"/>

        <addForeignKeyConstraint baseTableName="attachments" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_attachments_task"/>

        <addForeignKeyConstraint baseTableName="attachments" baseColumnNames="uploaded_by_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_attachments_user"/>

        <addForeignKeyConstraint baseTableName="task_history" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_history_task"/>

        <addForeignKeyConstraint baseTableName="task_history" baseColumnNames="changed_by_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_history_user"/>

        <addForeignKeyConstraint baseTableName="task_labels" baseColumnNames="task_id"
                                 referencedTableName="tasks" referencedColumnNames="id"
                                 constraintName="fk_task_labels_task"/>

        <addForeignKeyConstraint baseTableName="task_labels" baseColumnNames="label_id"
                                 referencedTableName="labels" referencedColumnNames="id"
                                 constraintName="fk_task_labels_label"/>

        <addForeignKeyConstraint baseTableName="notifications" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_notifications_user"/>

        <addForeignKeyConstraint baseTableName="sprints" baseColumnNames="project_id"
                                 referencedTableName="projects" referencedColumnNames="id"
                                 constraintName="fk_sprints_project"/>

        <!-- Insert default roles -->
        <insert tableName="roles">
            <column name="name" value="ROLE_ADMIN"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_MANAGER"/>
        </insert>
        <insert tableName="roles">
            <column name="name" value="ROLE_USER"/>
        </insert>

        <!-- Insert default admin user (password: admin123) -->
        <insert tableName="users">
            <column name="username" value="admin"/>
            <column name="email" value="admin@taskflow.com"/>
            <column name="password" value="$2a$10$dXJ3SW6G7P50lGmMkkmwe.20cQQubK3.HZWzG3YB1tlRy.fqvM/BG"/>
            <column name="first_name" value="Admin"/>
            <column name="last_name" value="User"/>
            <column name="enabled" value="true"/>
            <column name="role_id" value="1"/>
        </insert>
    </changeSet>
</databaseChangeLog>